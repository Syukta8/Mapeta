{
  "name": "mapeta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "download:map": "node scripts/download-offline-map.js",
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite",
    "client:build": "tsc -b && vite build",
    "client:preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist-server/index.js",
    "start": "node dist-server/index.js",
    "tunnel": "bin\\cloudflared.exe tunnel --url http://127.0.0.1:3000",
    "build": "npm run client:build && npm run server:build",
    "test": "cross-env MAPETA_DB_PATH=:memory: tsx --test client/src/__tests__/*.test.ts server/__tests__/*.test.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write \"{client,server,scripts}/**/*.{ts,tsx,js}\"",
    "deploy:pages": "npm run client:build && npx wrangler pages deploy dist --project-name mapeta",
    "build:apk": "node scripts/build-apk.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "5.7.8",
    "@capacitor/cli": "5.7.8",
    "@capacitor/core": "5.7.8",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "localtunnel": "^2.0.2",
    "postcss": "^8.5.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "wrangler": "^4.130.0"
  }
}
